FROM golang:1.26.10-alpine@sha256:5cb67f19c5e7994dcb80c074f7cfca8aeeada45bbdca035f73df269cefdcce61 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
ARG APP_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${APP_VERSION}" -o /out/wallet ./cmd/multi-chain-wallet

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/wallet /wallet
USER 10001:10001
ENV HTTP_HOST=0.0.0.0 PORT=8090 WALLET_DIR=/data/wallet
ARG APP_VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/a861252012/multi-chain-wallet" \
      org.opencontainers.image.revision="${APP_VERSION}"
EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 CMD ["/wallet", "--healthcheck"]
ENTRYPOINT ["/wallet"]
